--- a/benchmarks/utils/image_utils.py
+++ b/benchmarks/utils/image_utils.py
@@ -63,7 +63,23 @@ def _ghcr_token(repo: str, username: str | None, pat: str | None) -> str | None:
         headers["Authorization"] = (
             "Basic " + base64.b64encode(f"{username}:{pat}".encode()).decode()
         )
-    r = requests.get(url, headers=headers, timeout=10)
+    # LOCAL PATCH (10 Sep 2026, SWE-CC). A network failure here must not be
+    # fatal. `remote_image_exists` below already swallows RequestException and returns
+    # False, which correctly falls through to building locally -- but this token fetch
+    # runs BEFORE it, unguarded, so a DNS blip propagated out and killed the whole cell
