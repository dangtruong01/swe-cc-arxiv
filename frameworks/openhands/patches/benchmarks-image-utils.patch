+    # 9 Sep, and E6 attributes sympy's four ghcr.io losses to a retry pass rebuilding 26
+    # images at once (experiment-e6-openhands-sympy-pilot.md).
+    #
+    # Returning None is not a new code path: it is exactly what this function already
+    # returns when there is no token, and the caller then does an anonymous lookup.
+    # The check has never once succeeded for us -- every build reports status='built',
+    # because no prebuilt image exists for our SDK-sha x swebench-base combination -- so
+    # this trades nothing for removing a hard failure mode.
+    try:
+        r = requests.get(url, headers=headers, timeout=10)
+    except requests.RequestException:
+        return None
     if r.ok:
         return r.json().get("token")
     return None
